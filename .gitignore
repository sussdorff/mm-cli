# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.idea/
.vscode/
*.swp

# Testing
.coverage
htmlcov/
.pytest_cache/

# uv
uv.lock

# Claude Code runtime state is ignored; Library-managed Skill bridges are shared.
.claude/*
!.claude/skills/
!.claude/skills/**

# Cursor runtime state is ignored; Library-managed Skill bridges are shared.
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads JSONL export is local; Dolt is the source of truth.
.beads/issues.jsonl

# Beads runtime artifacts (run state, metrics)
.beads/runs/
.beads/export-state.json

# Session-close runner artifacts
.session-close-state.json
.session-close.lock
.library.lock.workspace-lock

